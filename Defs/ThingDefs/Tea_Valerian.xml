<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Tier 2: requires advanced tea cultivation. -->

  <!-- ===== Plant ===== -->
  <ThingDef ParentName="KM_TeaPlantBase">
    <defName>KM_Plant_Valerian</defName>
    <label>valerian plant</label>
    <description>A tall, pink-flowered herb grown for its earthy-smelling root. It's fussy to cultivate, but the dried root brews into a tea that brings deep, restful sleep.</description>
    <graphicData>
      <texPath>Things/Plant/PotatoPlant</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(235,190,210)</color>
    </graphicData>
    <plant>
      <immatureGraphicPath>Things/Plant/PotatoPlant_Immature</immatureGraphicPath>
      <growDays>12</growDays>
      <harvestedThingDef>KM_ValerianRootFresh</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <sowMinSkill>7</sowMinSkill>
      <sowResearchPrerequisites Inherit="False">
        <li>KM_AdvancedTeaCultivation</li>
      </sowResearchPrerequisites>
    </plant>
  </ThingDef>

  <!-- ===== Root ===== -->
  <ThingDef ParentName="KM_FreshTeaLeavesBase">
    <defName>KM_ValerianRootFresh</defName>
    <label>fresh valerian root</label>
    <description>Freshly dug valerian root. It must be dried on a drying rack before it can be brewed. Rain pauses drying outdoors. Left undried, it rots in about two weeks.</description>
    <graphicData>
      <texPath>Things/Item/Resource/PlantFoodRaw/Potatoes</texPath>
      <color>(215,190,160)</color>
    </graphicData>
    <comps>
      <li Class="KensMod.CompProperties_Dryable">
        <driedThingDef>KM_ValerianRootDried</driedThingDef>
        <daysToDry>2</daysToDry>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="KM_DriedTeaLeavesBase">
    <defName>KM_ValerianRootDried</defName>
    <label>dried valerian</label>
    <description>Dried and chopped valerian root, ready to be brewed into tea. Keeps indefinitely.</description>
    <graphicData>
      <texPath>Things/Item/Resource/PlantFoodRaw/Potatoes</texPath>
      <color>(170,140,110)</color>
    </graphicData>
  </ThingDef>

  <!-- ===== Tea ===== -->
  <ThingDef ParentName="KM_TeaBase">
    <defName>KM_ValerianTea</defName>
    <label>valerian tea</label>
    <description>An earthy, sedating tea. For about 12 hours after drinking it, the drinker sleeps more deeply and shrugs off a rough night (sleeping outside, on the ground, or in the cold or heat), but feels a little drowsy at work. Not addictive.</description>
    <descriptionHyperlinks>
      <HediffDef>KM_ValerianSoothed</HediffDef>
    </descriptionHyperlinks>
    <statBases>
      <WorkToMake>600</WorkToMake>
      <MarketValue>14</MarketValue>
    </statBases>
    <ingestible>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>KM_ValerianSoothed</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>KM_AdvancedTeaCultivation</researchPrerequisite>
      <skillRequirements Inherit="False">
        <Cooking>5</Cooking>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <KM_ValerianRootDried>4</KM_ValerianRootDried>
    </costList>
    <comps>
      <li Class="CompProperties_Drug">
        <addictiveness>0</addictiveness>
        <listOrder>115</listOrder>
      </li>
    </comps>
  </ThingDef>

  <!-- ===== Effect: ~12 hours. Also nullifies bad-sleep thoughts (see Patches/Valerian_SleepThoughts.xml). ===== -->
  <HediffDef>
    <defName>KM_ValerianSoothed</defName>
    <label>soothed by valerian</label>
    <labelNoun>a valerian soothing</labelNoun>
    <description>Valerian tea in the bloodstream. The pawn sleeps more deeply and isn't bothered by a rough night, but is a little drowsy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85,0.7,0.85)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <RestRateMultiplier>1.3</RestRateMultiplier>
        </statFactors>
        <statOffsets>
          <WorkSpeedGlobal>-0.05</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>KM_ValerianSoothed</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>KM_ValerianSoothed</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>soothed by valerian</label>
        <description>That valerian tea has me feeling calm and heavy-lidded.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
